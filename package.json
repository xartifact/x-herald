{
  "name": "x-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Modern LLM Gateway with protocol conversion, smart routing, and high availability",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:gateway & bun run dev:web",
    "dev:gateway": "cd apps/gateway && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "start": "cd apps/gateway && bun run start",
    "build": "cd apps/web && bun run build",
    "typecheck": "bun --filter '*' run typecheck",
    "lint": "bunx oxlint@1.72.0 .",
    "lint:fix": "bunx oxlint@1.72.0 . --fix",
    "format": "bunx oxfmt@0.57.0 .",
    "format:check": "bunx oxfmt@0.57.0 --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "cd apps/gateway && bun test",
    "test:ui": "cd apps/web && bun test --reporter=dots",
    "test:ui:watch": "cd apps/web && bun test",
    "test:e2e:ui": "cd apps/web && bunx playwright test --ui",
    "ci": "./scripts/ci.sh",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-query": "^5.101.1",
    "@xyflow/react": "^12.10.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.170.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vitest": "4.1.9"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
