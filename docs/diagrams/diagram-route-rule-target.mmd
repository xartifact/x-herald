  columns 2
  E1["RouteRuleEngine<br/>per-AM 编译缓存<br/>match(amId, ctx)"] E2["AccessModelRouter<br/>action 分发<br/>(~420 行不变)"]
end

T4["数据层"]
block:L4
  columns 2
  D1[("route_rules<br/>access_model_id FK<br/>graph JSONB<br/>active + version")] D2[("access_models<br/>(owner of route rules)")]
end

