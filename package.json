{
  "name": "x-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Modern LLM Gateway with protocol conversion, smart routing, and high availability",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:gateway & bun run dev:web",
    "dev:gateway": "cd apps/gateway && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "start": "cd apps/gateway && bun run start",
    "build": "bun run build:web",
    "build:web": "cd apps/web && bun run build",
    "typecheck": "(cd packages/db && npx tsc --noEmit) && (cd packages/shared && npx tsc --noEmit) && (cd apps/gateway && bun run typecheck) && (cd packages/ui && npx tsc --noEmit) && (cd packages/ui && npx tsc --noEmit -p tsconfig.ui.json) && (cd apps/web && npx tsc --noEmit) && (cd packages/ai-agent && npx tsc --noEmit)",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp check .",
    "test": "cd apps/gateway && bun test",
    "test:ui": "vp test run",
    "test:ui:watch": "vp test",
    "test:e2e:ui": "cd apps/web && bunx playwright test --ui",
    "prepare": "vp config",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-query": "^5.101.1",
    "@xyflow/react": "^12.10.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.170.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "vite-plus": "^0.2.1"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.9",
    "vite-plus": "latest"
  }
}
