{
  "compilerOptions": {
    "target": "ESNext", "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "paths": {
      "@xartifact/x-llm-gateway-shared": ["../../packages/shared/src"],
      "@xartifact/x-llm-gateway-ui": ["../../packages/ui/src"]
    }
  },
  "include": ["app", "vite.config.ts"]
}
