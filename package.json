{
  "name": "x-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Modern LLM Gateway with protocol conversion, smart routing, and high availability",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:web",
    "build:web": "cd apps/web && bun run build",
    "typecheck": "bun run --filter './apps/*' typecheck",
    "lint": "bun run --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.turbo packages/*/.turbo"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/bun": "latest",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.1"
  }
}
