{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["@types/bun"],
    "paths": {
      "@xartifact/x-herald-shared": ["../shared/src"],
      "@xartifact/x-herald-ui": ["."]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.ui.test.tsx"]
}
