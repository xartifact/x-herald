{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "incremental": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@/features/*": ["./src/features/*"],
      "@/core/*": ["./src/core/*"],
      "@/ui/*": ["./src/ui/*"],
      "@x-llm-gateway/shared": ["../../packages/shared/src"],
      "@x-llm-gateway/engine": ["../../packages/engine/src"],
      "@x-llm-gateway/ui": ["../../packages/ui/src"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".vinxi", ".next", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**/*", "src/test-react-ssr.ts", "src/mock-ssr.test.ts"]
}
