{
  "name": "x-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Modern LLM Gateway with protocol conversion, smart routing, and high availability",
  "workspaces": [
    "apps/*", "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:engine & bun run dev:tanstack",
    "dev:engine": "cd packages/engine && bun run dev",
    "dev:tanstack": "cd apps/tanstack && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "start": "cd packages/engine && bun run start",
    "build": "bun run build:tanstack",
    "build:tanstack": "cd apps/tanstack && bun run build",
    "build:web": "cd apps/web && bun run build",
    "typecheck": "cd packages/engine && bun run typecheck && cd apps/tanstack && npx tsc --noEmit",
    "lint": "bun run --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/bun": "latest",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.1"
  }
}
