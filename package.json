{
  "name": "x-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Modern LLM Gateway with protocol conversion, smart routing, and high availability",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vp dev apps/gateway & vp dev apps/web",
    "dev:gateway": "vp dev apps/gateway",
    "dev:web": "vp dev apps/web",
    "start": "cd apps/gateway && bun run start",
    "build": "vp build apps/web",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp check .",
    "test": "cd apps/gateway && bun test",
    "test:ui": "vp test run",
    "test:ui:watch": "vp test",
    "test:e2e:ui": "cd apps/web && bunx playwright test --ui",
    "ci": "vp check . && vp run -r typecheck && cd apps/gateway && bun test",
    "prepare": "vp config",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tanstack/react-query": "^5.101.1",
    "@xyflow/react": "^12.10.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.170.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "vite-plus": "^0.2.1"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vitest": "4.1.9",
    "vite-plus": "0.2.1"
  }
}
