# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Logging Configuration
# 日志级别: debug, info, warn, error (默认: info)
LOG_LEVEL=info
# 是否启用请求日志 (默认: true)
LOG_ENABLE_REQUEST=true
# 是否启用详细 debug 日志 (默认: false)
LOG_ENABLE_DEBUG=false

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=*

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llm_gateway
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Alternative: Use connection string
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/llm_gateway

# Admin Configuration
ADMIN_PASSWORD=change-me-in-production

# Metrics Configuration
METRICS_BUFFER_SIZE=10000
METRICS_FLUSH_INTERVAL=300000
METRICS_RETENTION_DAYS=30

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_TIMEOUT=5000
HEALTH_FAILURE_THRESHOLD=3

# Circuit Breaker Configuration
CB_FAILURE_THRESHOLD=3
CB_TIMEOUT=60000
CB_RESET_TIMEOUT=30000

# Stream Logging Configuration (Phase 2)
LOG_UPDATE_INTERVAL_MS=5000

# Cron Job Configuration (Phase 3)
CRON_SECRET=your-random-secret-here

# Model Mapping Configuration
# 是否启用模型映射功能（默认：true）
MODEL_MAPPING_ENABLED=true
# 默认模型组名称（当请求的模型不存在时fallback到此模型组）
MODEL_MAPPING_DEFAULT_GROUP=claude-3-sonnet
